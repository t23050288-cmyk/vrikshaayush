<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Shadow layer for 3D tactile effect -->
    <item android:top="4dp" android:left="2dp" android:right="2dp" android:bottom="0dp">
        <shape android:shape="rectangle">
            <solid android:color="#0A2E12"/>
            <corners android:radius="20dp"/>
        </shape>
    </item>
    <!-- Main button -->
    <item android:bottom="4dp">
        <shape android:shape="rectangle">
            <gradient android:startColor="#1E7A3C" android:endColor="#145828"
                android:angle="135" android:type="linear"/>
            <corners android:radius="20dp"/>
        </shape>
    </item>
</layer-list>
